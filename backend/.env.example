# Copy to backend/.env (never commit .env). All values are optional.

# SQLite database file. Relative paths resolve against backend/.
# Default: ../data/eventlens.db
EVENTLENS_DB_PATH=../data/eventlens.db

# Maximum upload size in megabytes.
EVENTLENS_MAX_UPLOAD_MB=5

# Optional override for the sample dataset path (default: ../data/sample_logs.json).
# EVENTLENS_SAMPLE_PATH=../data/sample_logs.json
